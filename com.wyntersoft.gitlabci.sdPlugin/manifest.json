{
	"$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
	"Name": "Pipeline Status for GitLab",
	"Version": "0.1.0.0",
	"Author": "Wyntersoft",
	"Description": "Watch GitLab CI from your Stream Deck keys and dials. Branch shows the latest pipeline's status (tap to retry a failed build, hold to cancel a running one; turn a dial to switch branch or project). Runner Health summarises runners online, building and queued jobs; turn its dial to see what each runner is building. Runner Status keys show a single runner.",
	"Category": "Pipeline Status for GitLab",
	"CategoryIcon": "imgs/plugin/category-icon",
	"Icon": "imgs/plugin/marketplace",
	"URL": "https://github.com/wyntersoft/streamdeck-gitlabci",
	"CodePath": "bin/plugin.js",
	"SDKVersion": 3,
	"Software": {
		"MinimumVersion": "7.1"
	},
	"OS": [
		{
			"Platform": "mac",
			"MinimumVersion": "12"
		},
		{
			"Platform": "windows",
			"MinimumVersion": "10"
		}
	],
	"Nodejs": {
		"Version": "24",
		"Debug": "enabled"
	},
	"UUID": "com.wyntersoft.gitlabci",
	"Actions": [
		{
			"Name": "Branch Status",
			"UUID": "com.wyntersoft.gitlabci.branch",
			"Icon": "imgs/actions/branch/icon",
			"Tooltip": "Latest pipeline for a branch. Tap retries a failed pipeline; hold cancels a running one.",
			"PropertyInspectorPath": "ui/branch.html",
			"SupportedInMultiActions": false,
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/branch/key",
					"ShowTitle": true,
					"TitleAlignment": "middle"
				}
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Switch branch / project",
					"Push": "Retry failed (hold: cancel running)",
					"Touch": "Retry failed",
					"LongTouch": "Cancel running"
				}
			}
		},
		{
			"Name": "Runner Status",
			"UUID": "com.wyntersoft.gitlabci.runner",
			"Icon": "imgs/actions/runner/icon",
			"Tooltip": "Shows whether a runner is idle or what it's building. (On dials, use Runner Health.)",
			"PropertyInspectorPath": "ui/runner.html",
			"SupportedInMultiActions": false,
			"Controllers": [
				"Keypad"
			],
			"States": [
				{
					"Image": "imgs/actions/runner/key",
					"ShowTitle": true,
					"TitleAlignment": "middle"
				}
			]
		},
		{
			"Name": "Runner Health",
			"UUID": "com.wyntersoft.gitlabci.health",
			"Icon": "imgs/actions/health/icon",
			"Tooltip": "Runners online, building, and jobs queued. On a dial, turn to see each runner.",
			"PropertyInspectorPath": "ui/health.html",
			"SupportedInMultiActions": false,
			"Controllers": [
				"Keypad",
				"Encoder"
			],
			"States": [
				{
					"Image": "imgs/actions/health/key",
					"ShowTitle": true,
					"TitleAlignment": "middle"
				}
			],
			"Encoder": {
				"layout": "layouts/canvas.json",
				"TriggerDescription": {
					"Rotate": "Overview / each runner"
				}
			}
		}
	]
}
