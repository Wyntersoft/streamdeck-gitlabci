{
	"name": "streamdeck-gitlabci",
	"version": "0.1.0",
	"private": true,
	"description": "Stream Deck plugin showing GitLab CI pipeline status on keys",
	"type": "module",
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w --watch.onEnd=\"streamdeck restart com.wyntersoft.gitlabci\"",
		"typecheck": "tsc --noEmit",
		"test": "node --test --experimental-strip-types test/*.test.ts",
		"pack": "streamdeck pack com.wyntersoft.gitlabci.sdPlugin --output dist --force",
		"icons": "node scripts/generate-icons.mjs"
	},
	"dependencies": {
		"@elgato/streamdeck": "^3.0.2"
	},
	"devDependencies": {
		"@elgato/cli": "^1.10.2",
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@tsconfig/node24": "^24.0.5",
		"@types/node": "^24.19.2",
		"rollup": "^4.64.9",
		"sharp": "^0.35.5",
		"tslib": "^2.8.1",
		"typescript": "^5.9.3"
	}
}
